# Cargo Rush vhost. One origin serves both deployables, which is what
# CargoUI's production environment assumes: `apiUrl: ''` means the SPA reaches
# the API by path alone, so there is no CORS preflight and the Sanctum session
# cookie is first-party.
#
# Placeholders are filled in by deploy/scripts/provision.sh:
#   __SERVER_NAME__   staging.example.com
#   __DEPLOY_PATH__   /var/www/cargo-rush/staging
#   __ENV_NAME__      staging
#   __PHP_VERSION__   8.3
#
# TLS is deliberately absent: `certbot --nginx -d __SERVER_NAME__` adds the
# 443 block and the redirect. Shipping cert paths for files that do not exist
# yet just means nginx refuses to start.

server {
    listen 80;
    listen [::]:80;
    server_name __SERVER_NAME__;

    # The SPA is the default document root. The API is carved out below.
    root __DEPLOY_PATH__/current/CargoUI/browser;
    index index.html;

    charset utf-8;

    # Proof-of-delivery photos and company logos go through here.
    client_max_body_size 20M;

    access_log /var/log/nginx/cargo-__ENV_NAME__-access.log;
    error_log  /var/log/nginx/cargo-__ENV_NAME__-error.log;

    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/plain text/css application/javascript application/json
               image/svg+xml application/x-font-ttf font/woff2;

    # ---------------------------------------------------------------
    # Laravel
    # ---------------------------------------------------------------
    # Everything the API owns, listed explicitly. `/up` is the health route
    # from bootstrap/app.php; `/login` and `/logout` are session routes the
    # SPA posts to. Anything not named here belongs to the Angular router.
    #
    # First regex block in the file, so it wins over the asset rules below —
    # nginx tries regex locations in the order they are written.
    location ~ ^/(api|sanctum|login|logout|up|build)(/|$) {
        root __DEPLOY_PATH__/current/CargoApi/public;
        try_files $uri $uri/ /index.php?$query_string;
    }

    # User uploads, straight off disk through the shared/storage symlink.
    # `^~` because a plain prefix would lose to the static-asset regex, which
    # resolves against the SPA root and would 404 every upload.
    location ^~ /storage/ {
        root __DEPLOY_PATH__/current/CargoApi/public;
        try_files $uri =404;
        expires 1h;
        access_log off;
    }

    location ~ \.php$ {
        root __DEPLOY_PATH__/current/CargoApi/public;

        include fastcgi_params;
        fastcgi_pass unix:/run/php/php__PHP_VERSION__-fpm.sock;
        fastcgi_index index.php;

        # $realpath_root, not $document_root. With a `current` symlink the two
        # differ, and FPM's opcache is keyed on the resolved path — pass
        # $document_root and every deploy appears to change nothing until FPM
        # is restarted outright.
        fastcgi_param SCRIPT_FILENAME $realpath_root$fastcgi_script_name;
        fastcgi_param DOCUMENT_ROOT $realpath_root;

        fastcgi_hide_header X-Powered-By;
        fastcgi_read_timeout 60;
        fastcgi_buffers 16 16k;
        fastcgi_buffer_size 32k;
    }

    # ---------------------------------------------------------------
    # Angular
    # ---------------------------------------------------------------
    # Hashed filenames (outputHashing: 'all'), so they can be cached forever.
    location ~* \.(?:js|css|woff2?|ttf|eot|png|jpe?g|gif|svg|ico|webp|avif|map)$ {
        try_files $uri =404;
        expires 1y;
        add_header Cache-Control "public, immutable";
        access_log off;
    }

    # The shell must never be cached: it is the file that names the current
    # release's chunks, so a stale copy asks for JavaScript that no longer
    # exists. Headers are repeated because a location with its own add_header
    # drops the server-level ones.
    location = /index.html {
        add_header Cache-Control "no-store, must-revalidate";
        add_header X-Frame-Options "SAMEORIGIN" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    }

    # Deep links (/employees, /payroll/…) are routes in the browser, not files.
    location / {
        try_files $uri $uri/ /index.html;
    }

    location ~ /\.(?!well-known) {
        deny all;
        access_log off;
    }
}

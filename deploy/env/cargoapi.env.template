# CargoApi environment for a deployed box.
#
# provision.sh copies this to <deploy_path>/shared/.env, fills in the marked
# values and generates APP_KEY. It lives outside any release, so it survives
# every deploy and is never in the repository.
#
# Anything left as CHANGE_ME must be set before the first deploy.

APP_NAME="Cargo Rush"
APP_ENV=__APP_ENV__
APP_KEY=
APP_DEBUG=__APP_DEBUG__
APP_URL=https://__SERVER_NAME__
APP_TIMEZONE=Asia/Manila

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

# Daily files rather than one growing `laravel.log`, and 14 days of them.
LOG_CHANNEL=daily
LOG_STACK=daily
LOG_LEVEL=__LOG_LEVEL__
LOG_DAILY_DAYS=14

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=__DB_DATABASE__
DB_USERNAME=__DB_USERNAME__
DB_PASSWORD=CHANGE_ME

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# Leading dot so the cookie is valid for the apex and any subdomain.
SESSION_DOMAIN=__SESSION_DOMAIN__
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# Sanctum's SPA guard checks the request Origin against this list. CargoUI is
# same-origin in production, but the check still runs — leave the host out and
# every authenticated request from the browser comes back 401.
SANCTUM_STATEFUL_DOMAINS=__SERVER_NAME__

# config/cors.php reads these. Same-origin means CORS never fires for CargoUI,
# but FRONTEND_URL is also what the API uses to build links into the SPA.
FRONTEND_URL=https://__SERVER_NAME__
EXPO_WEB_URL=https://__SERVER_NAME__

# Mail — password resets and invoice delivery go through this. `log` writes
# them to the log file instead of sending, which is the right default until
# real credentials are in place.
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@__SERVER_NAME__"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

{
  "expo": {
    "name": "Cargo Rush",
    "slug": "cargoApp",
    "version": "1.0.0",
    "owner": "glynn_dev",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "cargoapp",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Cargo Rush reports your position while you are on a trip, so dispatch can see where the load is.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Cargo Rush keeps reporting your position while the app is in the background, so a trip is tracked with the phone in its cradle and the screen off.",
        "UIBackgroundModes": [
          "location",
          "fetch"
        ]
      },
      "bundleIdentifier": "ph.cargorush.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#DFF0FF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION"
      ],
      "package": "ph.cargorush.app",
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/RaceSport.ttf"
          ]
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#DFF0FF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain"
        }
      ],
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Cargo Rush reports your position while you are on a trip, so dispatch can see where the load is — and pins the pickup or drop-off you are standing in when you ask it to.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Cargo Rush attaches a photo of the delivered load as proof of delivery.",
          "cameraPermission": "Cargo Rush uses the camera to photograph the load at the door as proof of delivery."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f0ff0b62-c525-4948-b050-77ca72d33289"
      }
    }
  }
}
